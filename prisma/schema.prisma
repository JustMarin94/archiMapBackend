generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model author_awards {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  author_id   String    @db.Uuid
  title       String    @db.VarChar(255)
  year        Int?
  description String?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  authors     authors   @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model author_group_members {
  group_id      String        @db.Uuid
  author_id     String        @db.Uuid
  role          String?       @db.VarChar(100)
  created_at    DateTime?     @default(now()) @db.Timestamp(6)
  authors       authors       @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_author")
  author_groups author_groups @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_group")

  @@id([group_id, author_id])
}

model author_groups {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String                 @unique(map: "uq_author_groups_name") @db.VarChar(255)
  description          String?
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @default(now()) @db.Timestamp(6)
  author_group_members author_group_members[]
  photos               photos[]
  work_authors         work_authors[]
}

model authors {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name            String                 @db.VarChar(255)
  birth_year           Int?
  death_year           Int?
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @default(now()) @db.Timestamp(6)
  education            String?
  description          String?
  author_awards        author_awards[]
  author_group_members author_group_members[]
  photos               photos[]
  work_authors         work_authors[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model photos {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url           String
  caption       String?
  alt_text      String?
  position      Int?           @default(0)
  author_id     String?        @db.Uuid
  work_id       String?        @db.Uuid
  created_at    DateTime?      @default(now()) @db.Timestamp(6)
  group_id      String?        @db.Uuid
  authors       authors?       @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  author_groups author_groups? @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  works         works?         @relation(fields: [work_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model work_authors {
  work_id       String         @db.Uuid
  author_id     String?        @db.Uuid
  role          String?        @db.VarChar(100)
  group_id      String?        @db.Uuid
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authors       authors?       @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  author_groups author_groups? @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  works         works          @relation(fields: [work_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([work_id, author_id], map: "uq_work_author")
  @@unique([work_id, group_id], map: "uq_work_group")
}

model works {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title             String         @db.VarChar(255)
  description       String?
  typology          String?        @db.VarChar(100)
  city              String?        @db.VarChar(100)
  latitude          Decimal?       @db.Decimal(10, 7)
  longitude         Decimal?       @db.Decimal(10, 7)
  created_at        DateTime?      @default(now()) @db.Timestamp(6)
  updated_at        DateTime?      @default(now()) @db.Timestamp(6)
  region            String?        @db.VarChar(100)
  awards            String?
  year_start        Int?
  year_end          Int?
  postal_code       String?        @db.VarChar(20)
  investor          String?
  protection_status String?
  address           String?
  status            String?
  intervention_type String?
  legacy_category   String?        @db.VarChar(50)
  photos            photos[]
  work_authors      work_authors[]
}

model users {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String    @unique(map: "uq_users_email") @db.VarChar(255)
  password   String    @db.VarChar(255)
  role       String    @default("user") @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
}
